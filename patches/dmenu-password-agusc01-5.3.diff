diff --git a/dmenu.1 b/dmenu.1
--- a/dmenu.1
+++ b/dmenu.1
@@ -4,6 +4,7 @@ dmenu \- dynamic menu
 .SH SYNOPSIS
 .B dmenu
 .RB [ \-bfiv ]
+.RB [ \-P ]
 .RB [ \-l
 .IR lines ]
 .RB [ \-title
@@ -91,6 +92,12 @@ yet supported.
 dmenu grabs the keyboard before reading stdin if not reading from a tty. This
 is faster, but will lock up X until stdin reaches end\-of\-file.
 .TP
+.B \-P
+replaces characters entered into the input field with dots, ignoring stdin menu entries; Return prints
+the actual value to standard output. This is for callers that consume it
+through a pipe, not on a command line. The flag cannot be combined with
+.BR \-preview .
+.TP
 .B \-i
 dmenu matches menu items case insensitively.
 .TP
diff --git a/dmenu.c b/dmenu.c
--- a/dmenu.c
+++ b/dmenu.c
@@ -67,6 +67,7 @@ static unsigned int using_vi_mode = 0;
 /* Optional title and asynchronous, text-only preview. */
 static const char *title = NULL, *preview_command = NULL, *preview_title = NULL;
 static unsigned int preview_size = 45;
+static int password_mode = 0; /* upstream password patch (-P), adapted for this fork */
 static struct item *preview_item = NULL;
 static int preview_fd = -1;
 static pid_t preview_pid = -1;
@@ -399,12 +400,23 @@ drawmenu(void)
 	unsigned int curpos;
 	struct item *item;
 	int x = 0, y = 0, fh = drw->fonts->h, w;
+	char masked[sizeof text];
+	const char *shown = text;
+	size_t k;
 	int titleh = title && *title ? bh : 0;
 	int listwidth = (preview_command && lines > 0)
 	              ? mw * (100 - preview_size) / 100 : mw;
 
 	preview_select();
 
+	/* Mask the input without altering the actual text or selection output. */
+	if (password_mode) {
+		for (k = 0; k < strlen(text); k++)
+			masked[k] = '.';
+		masked[k] = '\0';
+		shown = masked;
+	}
+
 	drw_setscheme(drw, scheme[SchemeNorm]);
 	drw_rect(drw, 0, 0, mw, mh, 1, 1);
 
@@ -420,13 +432,13 @@ drawmenu(void)
 	/* Draw input field, spanning the full width. */
 	w = (lines > 0 || !matches) ? mw - x : inputw;
 	drw_setscheme(drw, scheme[SchemeNorm]);
-	drw_text(drw, x, y, w, bh, lrpad / 2, text, 0);
+	drw_text(drw, x, y, w, bh, lrpad / 2, shown, 0);
 
-	curpos = TEXTW(text) - TEXTW(&text[cursor]);
+	curpos = TEXTW(shown) - TEXTW(&shown[cursor]);
 	curpos += lrpad / 2 - 1;
 	if (using_vi_mode && text[0] != '\0') {
 		drw_setscheme(drw, scheme[SchemeCursor]);
-		char vi_char[] = {text[cursor], '\0'};
+		char vi_char[] = {password_mode ? '.' : text[cursor], '\0'};
 		drw_text(drw, x + curpos, y, TEXTW(vi_char) - lrpad, bh, 0, vi_char, 0);
 	} else if (using_vi_mode) {
 		drw_setscheme(drw, scheme[SchemeNorm]);
@@ -1018,6 +1030,12 @@ readstdin(void)
 	size_t i, itemsiz = 0, linesiz = 0;
 	ssize_t len;
 
+	/* Upstream password patch: discard all menu items from standard input. */
+	if (password_mode) {
+		lines = 0;
+		return;
+	}
+
 	/* read each line from stdin and add it to the item list */
 	for (i = 0; (len = getline(&line, &linesiz, stdin)) != -1; i++) {
 		if (i + 1 >= itemsiz) {
@@ -1233,7 +1251,7 @@ setup(void)
 static void
 usage(void)
 {
-	die("usage: dmenu [-bcfivs] [-vi] [-l lines] [-h height] [-p prompt] [-fn font] [-m monitor]\n"
+	die("usage: dmenu [-bcfivsP] [-vi] [-l lines] [-h height] [-p prompt] [-fn font] [-m monitor]\n"
 	    "             [-nb color] [-nf color] [-sb color] [-sf color] [-bw width]\n"
 	    "             [-nhb color] [-nhf color] [-shb color] [-shf color] [-w windowid]\n"
 	    "             [-title text] [-preview executable] [-preview-title text]\n"
@@ -1265,6 +1283,8 @@ main(int argc, char *argv[])
 			fast = 1;
 		else if (!strcmp(argv[i], "-c"))   /* centers dmenu on screen */
 			centered = 1;
+		else if (!strcmp(argv[i], "-P"))
+			password_mode = 1;
 		else if (!strcmp(argv[i], "-i")) { /* case-insensitive item matching */
 			fstrncmp = strncasecmp;
 			fstrstr = cistrstr;
@@ -1329,6 +1349,10 @@ main(int argc, char *argv[])
 		else
 			usage();
 
+	/* A password prompt must never send the secret to an external preview. */
+	if (password_mode && preview_command)
+		usage();
+
 	if (!setlocale(LC_CTYPE, "") || !XSupportsLocale())
 		fputs("warning: no locale support\n", stderr);
 	if (!(dpy = XOpenDisplay(NULL)))
